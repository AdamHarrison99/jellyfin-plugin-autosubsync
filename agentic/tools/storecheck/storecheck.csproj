<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>StoreCheck</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>storecheck</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
  </ItemGroup>

  <!-- The real sources, linked so the harness exercises shipping code and not a copy. -->
  <ItemGroup>
    <Compile Include="..\..\..\Models\*.cs" LinkBase="Models" />
    <Compile Include="..\..\..\PluginPaths.cs" Link="PluginPaths.cs" />
    <Compile Include="..\..\..\Data\SyncStore.cs" Link="SyncStore.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="v1-records.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
