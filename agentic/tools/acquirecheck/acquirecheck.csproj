<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>AcquireCheck</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>acquirecheck</AssemblyName>
    <NoWarn>$(NoWarn);CA1050;CA1707;SA0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
  </ItemGroup>

  <!-- The real sources, linked so the harness drives shipping code and not a copy. -->
  <ItemGroup>
    <Compile Include="..\..\..\Models\*.cs" LinkBase="Models" />
    <Compile Include="..\..\..\Configuration\PluginConfiguration.cs" Link="PluginConfiguration.cs" />
    <Compile Include="..\..\..\Cli\SyncEngine.cs" Link="SyncEngine.cs" />
    <Compile Include="..\..\..\Services\ProviderRetirement.cs" Link="ProviderRetirement.cs" />
    <Compile Include="..\..\..\Services\SubtitleAcquirer.cs" Link="SubtitleAcquirer.cs" />
    <Compile Include="..\..\..\Subtitles\DownloadProviders.cs" Link="DownloadProviders.cs" />
    <Compile Include="..\..\..\Subtitles\ISubtitleExtractor.cs" Link="ISubtitleExtractor.cs" />
    <Compile Include="..\..\..\Subtitles\ISubtitleSource.cs" Link="ISubtitleSource.cs" />
    <Compile Include="..\..\..\Subtitles\LanguageCodes.cs" Link="LanguageCodes.cs" />
    <Compile Include="..\..\..\Subtitles\SdhDetector.cs" Link="SdhDetector.cs" />
    <Compile Include="..\..\..\Subtitles\SdhNaming.cs" Link="SdhNaming.cs" />
    <Compile Include="..\..\..\Subtitles\SubtitleContent.cs" Link="SubtitleContent.cs" />
    <Compile Include="..\..\..\Subtitles\SubtitleDiscoveryService.cs" Link="SubtitleDiscoveryService.cs" />
    <Compile Include="..\..\..\Subtitles\SubtitleNaming.cs" Link="SubtitleNaming.cs" />
    <Compile Include="..\..\..\Subtitles\SubtitleSlot.cs" Link="SubtitleSlot.cs" />
    <Compile Include="..\..\..\Subtitles\SubtitleSourceKey.cs" Link="SubtitleSourceKey.cs" />
    <Compile Include="..\..\..\Subtitles\VobSubIndex.cs" Link="VobSubIndex.cs" />
  </ItemGroup>

</Project>
